default_platform(:ios)

platform :ios do
  desc "Build, sign und Upload zu TestFlight (ohne eigenen Mac, über App-Store-Connect-API-Key)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_P8"],
      is_key_content_base64: false,
      in_house: false
    )

    # App-Datensatz in App Store Connect anlegen, falls noch nicht vorhanden
    begin
      produce(
        app_identifier: "at.spanwerk.kassiersystem",
        app_name: "Kassiersystem",
        language: "German",
        skip_itc: false,
        skip_devcenter: false,
        team_id: ENV["APPLE_TEAM_ID"]
      )
    rescue => e
      UI.important("produce übersprungen (App existiert evtl. schon): #{e.message}")
    end

    # Automatische Signatur über den API-Key aktivieren
    update_code_signing_settings(
      use_automatic_signing: true,
      path: "ios/App/App.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"]
    )

    # Build-Nummer = Lauf-Zeitstempel (immer eindeutig, Apple verlangt steigende Nummern)
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: Time.now.strftime("%Y%m%d%H%M")
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      output_directory: "build",
      output_name: "Kassiersystem.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
