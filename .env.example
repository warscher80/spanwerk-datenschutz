# Preisschmiede – Beispiel-Umgebungsdatei
# =========================================================================
# WICHTIG: Diese App laeuft aktuell vollstaendig OFFLINE und LOKAL (reines
# HTML/CSS/JS, localStorage). Sie benoetigt zur Laufzeit KEINE Datenbank,
# KEINEN Server und KEINE Secrets. Die meisten Variablen unten sind fuer
# einen SPAETEREN Server-/Backend-Betrieb vorbereitet und dort NICHT aktiv.
#
# Regeln:
#  * NIEMALS echte Secrets committen. Diese Datei enthaelt nur Beispiele.
#  * Secrets gehoeren in eine Secret-Verwaltung, nicht ins Repository.
#  * Validierung beim Start:  node scripts/check-env.mjs [pfad-zur-.env]
#    (meldet fehlende Pflichtvariablen OHNE Werte auszugeben).
#
# Format je Zeile:  NAME=beispiel   # [Pflicht?] Format · Umgebung · Zweck
# =========================================================================

# ---- Anwendung ----------------------------------------------------------
APP_BASE_URL=                      # optional · url · prod · Basis-URL (nur Server-Hosting)
APP_BUILD_CHANNEL=dev              # optional · dev|test|prod · alle · Build-Kennzeichnung
APP_SHOW_EXAMPLE_DATA=true         # optional · bool · alle · in Produktion auf false

# ---- Datenbank (nur mit Backend; offline nicht genutzt) -----------------
DATABASE_URL=                      # optional · url · prod-backend · PostgreSQL-Verbindung
DATABASE_POOL_MAX=                 # optional · int · prod-backend · max. Verbindungen im Pool

# ---- Authentifizierung (nur mit Backend) --------------------------------
AUTH_SESSION_SECRET=               # optional · secret>=32 · prod-backend · Sitzungs-/Token-Signatur

# ---- Dateispeicher (nur mit Backend; offline: localStorage) -------------
STORAGE_BUCKET=                    # optional · string · prod-backend · Objektspeicher-Bucket
STORAGE_SIGNING_SECRET=            # optional · secret>=32 · prod-backend · Signatur fuer Download-Links

# ---- E-Mail (ohne Anbieter: Vorschaumodus, kein Versand) ----------------
EMAIL_PROVIDER=none                # optional · none|smtp|api · prod-backend · none = Vorschau
EMAIL_API_KEY=                     # optional · secret · prod-backend · Zugang zum E-Mail-Dienst
EMAIL_FROM=                        # optional · email · prod-backend · Absender (verifizierte Domain)

# ---- PDF ----------------------------------------------------------------
PDF_ENGINE=client                  # optional · client|server · alle · client = im Browser

# ---- Hintergrundaufgaben ------------------------------------------------
QUEUE_DRIVER=inapp                 # optional · inapp|redis · prod-backend · inapp = im Client

# ---- Monitoring / Fehlertracking (optional, ohne PII) -------------------
MONITORING_URL=                    # optional · url · prod · externer Monitoring-Endpunkt
ERROR_TRACKING_DSN=                # optional · string · prod · Fehlertracking-DSN

# ---- Lieferanten (nicht konfiguriert) -----------------------------------
FRANKSTAHL_API_BASEURL=            # optional · url · prod-backend · Lieferantenschnittstelle
FRANKSTAHL_API_KEY=                # optional · secret · prod-backend · Lieferanten-API-Schluessel

# ---- ERP (Dateiexport) --------------------------------------------------
KINGBILL_EXPORT_DIR=               # optional · path · prod-backend · KingBill-Exportpfad
OCR_SERVICE_URL=                   # optional · url · prod-backend · OCR-Dienst (nicht konfiguriert)

# ---- Zahlungsanbieter (keine echte Abbuchung; none/manual) --------------
PAYMENT_PROVIDER=none              # optional · none|stripe|manual · prod-backend · none/manual = manuell
PAYMENT_WEBHOOK_SECRET=            # optional · secret>=16 · prod-backend · Webhook-Signaturpruefung

# ---- Sicherheit ---------------------------------------------------------
RATE_LIMIT_LOGIN=5                 # optional · int · prod · max. Fehlanmeldungen je Fenster
ALLOWED_REDIRECT_URLS=             # optional · csv-url · prod · erlaubte Redirect-Ziele (Whitelist)
