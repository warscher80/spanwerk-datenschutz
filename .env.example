# Preisschmiede – Beispiel-Umgebungsdatei
# =========================================
# Diese App laeuft vollstaendig OFFLINE und LOKAL (reines HTML/CSS/JS,
# localStorage). Sie benoetigt zur Laufzeit KEINE Datenbank, KEINEN Server
# und KEINE Geheimnisse. Diese Datei enthaelt daher nur optionale
# Build-/CI-Schalter – NIEMALS echte Zugangsdaten committen.

# Optionale Build-Kennzeichnung (wird in build-info.js angezeigt)
APP_BUILD_CHANNEL=dev            # dev | test | prod
APP_SHOW_EXAMPLE_DATA=true       # im Produktivbetrieb auf false setzen

# Platzhalter fuer SPAETER geplante, NICHT konfigurierte Schnittstellen.
# Leer lassen. Werden erst mit einem echten Backend/Adapter genutzt und
# gehoeren dann in eine Secret-Verwaltung, nicht ins Repository.
FRANKSTAHL_API_BASEURL=
FRANKSTAHL_API_KEY=
KINGBILL_EXPORT_DIR=
OCR_SERVICE_URL=
